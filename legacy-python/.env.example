# Copy to .env and fill in. Never commit .env.

# Public address
DOMAIN=car.mwizerwa.com
PUBLIC_URL=https://car.mwizerwa.com
# Let's Encrypt sends certificate warnings here
ACME_EMAIL=you@example.com

# Database password. Letters and digits only, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Optional: free key from https://opencellid.org to place vehicles by cell tower when GPS has no fix
OPENCELLID_KEY=

# Time zone shown in the web interface
DISPLAY_TZ=Africa/Kigali
# A vehicle counts as "reporting" if heard from within this many seconds
ONLINE_SECONDS=180
# Delete readings older than this many days (0 = keep forever)
RETENTION_DAYS=0
# Hours before a web session expires
SESSION_HOURS=12
