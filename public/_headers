# Headers for static files (Function responses set their own headers in src/app.js).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Pages links these with ?v=N (src/views.js), so browsers may keep them for a long time.
/static/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self' data:

/api/docs
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' https://cdn.jsdelivr.net; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self'; frame-ancestors 'none'
